# =====================================================================
# PRAJWALKUMAR MADIWAL — PORTFOLIO ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Contact Form & Quote Dispatch (Submissions routed to pkm.digi@gmail.com)
# Get a free access key at https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here
# Optional Resend API key for custom transactional routing
RESEND_API_KEY=

# 2. Google Gemini API for AI Chatbot & Job Fit Analyzer (Server-side only)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 3. Calendar & Booking Integration
# Cal.com or Calendly direct event link (e.g., https://cal.com/prajwalkumar/15min)
NEXT_PUBLIC_CALENDLY_URL=
CAL_LINK=

# 4. Newsletter / "Thoughts" Subscription
# Buttondown or custom newsletter subscription form action URL
NEXT_PUBLIC_NEWSLETTER_URL=

# 5. Direct Connect & Analytics
# WhatsApp phone in international format without plus (e.g., 919876543210)
NEXT_PUBLIC_WHATSAPP_PHONE=
# Cookie-free privacy-respecting analytics ID (Vercel Analytics or Plausible)
NEXT_PUBLIC_ANALYTICS_ID=

# 6. Cloned Voice Assistant ("Ask Srushti" Female AI Voice — Server-side only)
# Get your API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Female AI Voice ID for Srushti (Defaults to Rachel: 21m00Tcm4TlvDq8ikWAM, or your custom cloned voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Provider adapter: elevenlabs (default) or cartesia
TTS_PROVIDER=elevenlabs
# Daily character budget cap (default 50,000 characters; auto-falls back to browser voice when reached)
TTS_DAILY_CHAR_LIMIT=50000
